generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  role_1
  role_2
  admin
}

enum BillType {
  grn_bill
  miscellaneous
}

enum InvoiceStatus {
  draft
  pending_review
  sent_back
  re_submitted
  approved
  reconciled
  paid
}

enum GrnEntryStatus {
  pending
  reconciled
  disputed
  paid
}

enum SyncRunStatus {
  processing
  completed
  has_conflicts
}

enum ReconciliationStatus {
  running
  completed
}

enum MatchStatus {
  matched
  amount_diff
  app_only
  excel_only
}

enum Resolution {
  accepted_app
  accepted_excel
  disputed
}

enum ConflictResolution {
  keep_system
  use_excel
}

enum PaymentMode {
  neft
  rtgs
  cheque
  cash
}

enum OcrStatus {
  pending
  processing
  done
  failed
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users    UserDepartment[]
  invoices Invoice[]
}

model Vendor {
  id                String    @id @default(uuid())
  name              String
  contactName       String?
  phone             String?
  email             String?
  gstNumber         String?
  bankName          String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankAccountName   String?
  bankBranch        String?
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoices  Invoice[]
  grnMaster GrnMaster[]
  payments  Payment[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  departments         UserDepartment[]
  uploadedInvoices    Invoice[]           @relation("UploadedBy")
  reviewedInvoices    Invoice[]           @relation("ReviewedBy")
  invoiceVersions     InvoiceVersion[]
  grnSyncRuns         GrnSyncRun[]
  conflictResolutions GrnConflict[]
  reconRuns           ReconciliationRun[]
  reconResolutions    ReconResult[]
  payments            Payment[]
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([email])
  @@index([role])
}

model UserDepartment {
  id           String     @id @default(uuid())
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
}

model Invoice {
  id               String        @id @default(uuid())
  vendorId         String
  invoiceNumber    String
  invoiceDate      DateTime?
  invoiceAmount    Decimal       @db.Decimal(12, 2)
  departmentId     String?
  billType         BillType
  miscCategory     String?
  miscDescription  String?
  fileUrl          String?
  ocrRawText       String?
  ocrExtractedJson Json?
  ocrStatus        OcrStatus     @default(pending)
  ocrModelUsed     String?
  ocrProcessedAt   DateTime?
  ocrRawData       Json?
  status           InvoiceStatus @default(draft)
  isPriceRevised   Boolean       @default(false)
  currentVersionNo Int           @default(1)
  submittedAt      DateTime?
  uploadedBy       String
  reviewedBy       String?
  reviewerNote     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  vendor     Vendor       @relation(fields: [vendorId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])
  uploader   User         @relation("UploadedBy", fields: [uploadedBy], references: [id])
  reviewer   User?        @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  versions   InvoiceVersion[]
  grnEntries GrnEntry[]

  @@index([vendorId])
  @@index([status])
  @@index([uploadedBy])
  @@index([departmentId])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@unique([vendorId, invoiceNumber])
}

model InvoiceVersion {
  id             String        @id @default(uuid())
  invoiceId      String
  versionNo      Int
  fileUrl        String?
  invoiceAmount  Decimal       @db.Decimal(12, 2)
  statusAtChange InvoiceStatus
  changedBy      String
  changeReason   String?
  createdAt      DateTime      @default(now())

  invoice       Invoice @relation(fields: [invoiceId], references: [id])
  changedByUser User    @relation(fields: [changedBy], references: [id])

  @@index([invoiceId])
}

model GrnEntry {
  id        String         @id @default(uuid())
  invoiceId String
  grnNumber String         @unique
  grnAmount Decimal        @db.Decimal(12, 2)
  grnDate   DateTime?
  status    GrnEntryStatus @default(pending)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  reconResults ReconResult[]
  paymentGrns  PaymentGrn[]

  @@index([invoiceId])
  @@index([grnNumber])
  @@index([status])
}

model GrnMaster {
  id            String    @id @default(uuid())
  vendorId      String?
  invoiceNumber String?
  grnNumber     String
  grnAmount     Decimal   @db.Decimal(12, 2)
  grnDate       DateTime?
  syncRunId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor       Vendor?       @relation(fields: [vendorId], references: [id])
  syncRun      GrnSyncRun?   @relation(fields: [syncRunId], references: [id])
  reconResults ReconResult[]

  @@index([grnNumber])
  @@index([vendorId])
  @@index([syncRunId])
}

model GrnSyncRun {
  id        String        @id @default(uuid())
  fileUrl   String?
  runBy     String
  totalRows Int           @default(0)
  inserted  Int           @default(0)
  skipped   Int           @default(0)
  conflicts Int           @default(0)
  status    SyncRunStatus @default(processing)
  createdAt DateTime      @default(now())

  runner        User          @relation(fields: [runBy], references: [id])
  grnMasterRows GrnMaster[]
  grnConflicts  GrnConflict[]

  @@index([status])
  @@index([createdAt])
}

model GrnConflict {
  id           String              @id @default(uuid())
  syncRunId    String
  grnNumber    String
  systemAmount Decimal             @db.Decimal(12, 2)
  excelAmount  Decimal             @db.Decimal(12, 2)
  resolvedBy   String?
  resolution   ConflictResolution?
  adminNote    String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())

  syncRun  GrnSyncRun @relation(fields: [syncRunId], references: [id])
  resolver User?      @relation(fields: [resolvedBy], references: [id])

  @@index([syncRunId])
  @@index([grnNumber])
}

model ReconciliationRun {
  id              String               @id @default(uuid())
  periodMonth     Int
  periodYear      Int
  runBy           String
  status          ReconciliationStatus @default(running)
  totalMatched    Int                  @default(0)
  totalAmountDiff Int                  @default(0)
  totalAppOnly    Int                  @default(0)
  totalExcelOnly  Int                  @default(0)
  completedAt     DateTime?
  completedBy     String?
  createdAt       DateTime             @default(now())

  runner  User          @relation(fields: [runBy], references: [id])
  results ReconResult[]

  @@index([periodMonth, periodYear])
  @@index([status])
}

model ReconResult {
  id          String      @id @default(uuid())
  reconRunId  String
  grnEntryId  String?
  grnMasterId String?
  matchStatus MatchStatus
  appAmount   Decimal?    @db.Decimal(12, 2)
  excelAmount Decimal?    @db.Decimal(12, 2)
  resolution  Resolution?
  resolvedBy  String?
  adminNote   String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())

  reconRun  ReconciliationRun @relation(fields: [reconRunId], references: [id])
  grnEntry  GrnEntry?         @relation(fields: [grnEntryId], references: [id])
  grnMaster GrnMaster?        @relation(fields: [grnMasterId], references: [id])
  resolver  User?             @relation(fields: [resolvedBy], references: [id])

  @@index([reconRunId])
  @@index([matchStatus])
  @@index([grnEntryId])
}

model Payment {
  id             String      @id @default(uuid())
  vendorId       String
  periodMonth    Int
  periodYear     Int
  totalAmount    Decimal     @db.Decimal(12, 2)
  paymentDate    DateTime
  paymentMode    PaymentMode
  transactionRef String?
  remarks        String?
  emailSent      Boolean     @default(false)
  emailSentAt    DateTime?
  createdBy      String
  createdAt      DateTime    @default(now())

  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  creator     User         @relation(fields: [createdBy], references: [id])
  paymentGrns PaymentGrn[]

  @@index([vendorId])
  @@index([periodMonth, periodYear])
}

model PaymentGrn {
  id        String @id @default(uuid())
  paymentId String
  grnId     String

  payment Payment  @relation(fields: [paymentId], references: [id])
  grn     GrnEntry @relation(fields: [grnId], references: [id])

  @@unique([paymentId, grnId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}
