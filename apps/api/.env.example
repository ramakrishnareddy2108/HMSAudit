# Supabase (PostgreSQL + Auth)
DATABASE_URL=postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@[host]:5432/postgres
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 Storage
# Create a bucket named hms-invoices in Cloudflare R2 (private)
# Generate R2 API tokens at: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hms-invoices
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Redis (Upstash)
REDIS_URL=rediss://default:[token]@[host].upstash.io:6379

# Google Cloud Vision (OCR)
# Enable Cloud Vision API and create an API key at: console.cloud.google.com
GOOGLE_CLOUD_VISION_API_KEY=

# OpenAI (OCR Stage 2 refinement)
OPENAI_API_KEY=

# Resend (Email)
RESEND_API_KEY=

# App
API_PORT=3001
NODE_ENV=development

# Set to 0 in development only if SSL handshake errors occur (EPROTO / SSL alert 40)
# Never set to 0 in production
NODE_TLS_REJECT_UNAUTHORIZED=1
